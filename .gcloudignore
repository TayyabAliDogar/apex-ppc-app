# This file specifies files that are *not* uploaded to Google Cloud
# using gcloud. It follows the same syntax as .gitignore

.gcloudignore
.git
.gitignore

# Dependencies (will be installed in container)
node_modules/

# Build output (will be built in container)
dist/
dist-ssr/

# Environment files
.env
.env.local

# Documentation
*.md
docs/

# Logs and test files
*.log
*.csv

# IDE
.vscode/
.claude/

# Deployment configs
deploy.bat
app.yaml

# Backup files
tailwind.config.backup.js
